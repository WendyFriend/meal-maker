{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.mealmaker.me" }],
            "destination": "https://mealmaker.me/$1",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "missing": [{ "type": "host", "value": "mealmaker.me" }],
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
        }
    ],
    "rewrites": [
        { "source": "/my-plan", "destination": "/index.html" },
        { "source": "/my-recipes", "destination": "/index.html" },
        { "source": "/my-ingredients", "destination": "/index.html" },
        { "source": "/settings", "destination": "/index.html" }
    ]
}
